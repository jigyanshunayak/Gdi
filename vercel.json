
{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/about-gdi\\.php$",
      "dest": "/api/about-gdi.php"
    },
    {
      "src": "^/contactus\\.php$",
      "dest": "/api/contactus.php"
    },
    {
      "src": "^/gallery\\.php$",
      "dest": "/api/gallery.php"
    },
    {
      "src": "^/who-we-are\\.php$",
      "dest": "/api/who-we-are.php"
    },
    {
      "src": "^/what-we-do\\.php$",
      "dest": "/api/what-we-do.php"
    }
  ]
}
